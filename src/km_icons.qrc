<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/km-icons">
        <!--
            Multi-size master pair (48 + 256) embedded for the window icon:
            each size maps to its own DISTINCT alias so rcc does not apply
            last-wins dedupe (a single shared alias would silently collapse
            both to one image). Installed use still resolves the hicolor
            theme icon as before.
        -->
        <file alias="48x48.png">../icons/48x48/org.archlinux.KernelManager.png</file>
        <file alias="256x256.png">../icons/256x256/org.archlinux.KernelManager.png</file>
    </qresource>
</RCC>
