#!/usr/bin/bash
#
###
# This code has been taken from Garuda
# Its is only temporal implementation
###
#
# This script tries to exec a terminal emulator by trying some known terminal
# emulators.
#
# Invariants:
# 1. $TERMINAL must come first
# 2. Distribution-specific mechanisms come next, e.g. x-terminal-emulator
# 3. The terminal emulator with best accessibility comes first.
# 4. No order is guaranteed/desired for the remaining terminal emulators.

set -e
LAUNCHER_CMD=bash

usage() {
    echo "Usage: ${0##*/} [cmd]"
    echo '    -s [shell]         Change shell to [shell]'
    echo '    -h                 This help'
    exit 1
}

opts='s:h'

while getopts "${opts}" arg; do
    case "${arg}" in
        s) LAUNCHER_CMD="$OPTARG" ;;
        h|?) usage 0 ;;
        *) echo "invalid argument '${arg}'"; usage 1 ;;
    esac
done

shift $(($OPTIND - 1))

file="$(mktemp)"
pidfile="$file.pid"

# Escalation: the C++ passes exactly 'pkexec "<KM_HELPER_DIR>/rootshell.sh"'
# via -s (run_cmd_async / runCmdTerminal) — prefix-match on pkexec.
case "$LAUNCHER_CMD" in
    pkexec*) escalated=1 ;;
    *)       escalated=0 ;;
esac

cmd="${LAUNCHER_CMD} \"$file\""
echo $cmd

terminal=""
declare -A terminals=(
    ["alacritty"]="alacritty -e $cmd || LIBGL_ALWAYS_SOFTWARE=1 alacritty -e $cmd"
    ["kitty"]="kitty $cmd"
    ["ptyxis"]="ptyxis -- $cmd"
    ["konsole"]="konsole -e $cmd"
    ["kgx"]="kgx --wait -- $cmd"
    ["gnome-terminal"]="gnome-terminal --wait -- $cmd"
    ["xfce4-terminal"]="xfce4-terminal --disable-server --command '$cmd'"
    ["lxterminal"]="lxterminal -e $cmd"
    ["xterm"]="xterm -e $cmd"
    ["st"]="st $cmd"
    ["foot"]="foot $cmd"
    ["rio"]="rio -e $cmd"
    ["ghostty"]="ghostty -e $cmd"
)
declare -a term_order=("alacritty" "kitty" "ptyxis" "konsole" "kgx" "gnome-terminal" "xfce4-terminal" "lxterminal" "xterm" "st" "foot" "rio" "ghostty")

if [ -z "$terminal" ] || ! command -v "$terminal" &> /dev/null; then
for entry in ${term_order[@]}; do
    if command -v "$entry" > /dev/null 2>&1; then
        terminal="$entry"
        break;
    fi
done
fi

if [ -z "$terminal" ]; then
    notify-send -t 1500 --app-name=Kernel Manager "No terminal installed" "Could not find a terminal emulator. Please install one."
    exit 1
fi

# Sentinel launch/rc protocol (chunk D — closes H3): the terminal runs a
# wrapper ($file) that drops filesystem sentinels in a world-readable run
# dir; the helper polls them. Konsole/ptyxis are D-Bus singletons —
# `konsole -e <cmd>` returns 0 the moment the window is requested, so the
# launcher's rc never carries the command's rc (the old escalated path was
# a fire-and-forget `exit 0`: the app saw 0 for a failed command and
# reported a false SUCCESS). With the sentinel, helper-lifetime ==
# command-lifetime for EVERY launch (blocking or non-blocking, escalated
# or not), and the helper's exit code IS the command's real rc —
# runCmdTerminal (utils.cpp: waitForFinished → exitCode) needs no change.
#
#   wrapper (run by the terminal's shell — as the user, or as root via
#   `pkexec rootshell.sh` for an escalated launch):
#     umask 022          root-written markers stay world-readable
#     touch started      the window actually ran the wrapper (Polkit OK)
#     trap INT/TERM      write rc 130/143 (the killed command's $? agrees)
#     ( <CMD> )          the command in a SUBSHELL: a command-level `exit`
#                        kills only the subshell, so the bookkeeping below
#                        always runs and the real rc is always recorded
#     echo $? > rc       the command's real rc (the single source of truth)
#     touch done         the lifecycle is over
#     (kgx only)         kgx does not exit on command completion — kill
#                        the window manually (the old line, folded here)
#   The wrapper does NOT remove the run dir — the helper owns the cleanup
#   after it has read the rc (a wrapper-side rm would race the done poll).
#
#   helper poll (the KMH_* env vars exist for the test harness only; the
#   production defaults are 120 s / 1800 s = 30 min):
#     wait started: 0.2 s ticks, ${KMH_START_TIMEOUT:-120} s deadline ⇒
#         never seen = Polkit rejected / window never opened ⇒ exit 126
#     wait done:    1 s ticks,   ${KMH_DONE_TIMEOUT:-1800}  s deadline ⇒
#         timeout = the command ran past 30 min ⇒ rc 124
#     read rc from the sentinel ⇒ exit $rc

run_dir="$(mktemp -d)"
chmod 0755 "$run_dir"

{
    echo 'umask 022'
    echo "touch '$run_dir/started'"
    echo "trap 'echo 130 > $run_dir/rc' INT"
    echo "trap 'echo 143 > $run_dir/rc' TERM"
    printf '( %s )\n' "$1"
    echo 'rc=$?'
    echo "echo \$rc > '$run_dir/rc'"
    echo "touch '$run_dir/done'"
    if [ "$terminal" = "kgx" ]; then
        echo "kill -SIGQUIT \$PPID 2>/dev/null"
    fi
    echo 'exit $rc'
} > "$file"

# Launch the terminal with the wrapper. The launcher's own rc is
# meaningless for konsole/ptyxis (D-Bus — the request returns immediately)
# and at best a proxy elsewhere, so the sentinels are the single source of
# truth for every launch; the eval is `|| true` — a failed launcher
# surfaces as `started` never appearing ⇒ 126 below.
eval "${terminals[$terminal]}" 2>/dev/null || true

# Wait for `started`: 0.2 s ticks, ${KMH_START_TIMEOUT:-120} s deadline.
# Never seen ⇒ Polkit rejected / the window never opened ⇒ 126.
deadline=$(( SECONDS + ${KMH_START_TIMEOUT:-120} ))
while [ ! -f "$run_dir/started" ]; do
    if [ "$SECONDS" -ge "$deadline" ]; then
        rm -rf "$run_dir"
        rm -f "$pidfile" "$file"
        exit 126
    fi
    sleep 0.2
done

# Wait for `done`: 1 s ticks, ${KMH_DONE_TIMEOUT:-1800} s (30 min) deadline.
# Timeout ⇒ the command ran past the limit ⇒ 124.
rc=""
deadline=$(( SECONDS + ${KMH_DONE_TIMEOUT:-1800} ))
while [ ! -f "$run_dir/done" ]; do
    if [ "$SECONDS" -ge "$deadline" ]; then
        rc=124
        break
    fi
    sleep 1
done

# The sentinel's rc is the command's real rc (the wrapper wrote it; the
# traps wrote 130/143). Guard the degenerate empty / non-numeric case.
if [ -z "$rc" ]; then
    rc="$(cat "$run_dir/rc" 2>/dev/null)" || rc=""
    case "$rc" in
        '' | *[!0-9]*) rc=124 ;;
    esac
fi

# Cleanup: the user owns $run_dir (0755), so the root-written markers
# inside are unlinkable by the user's helper; $file/$pidfile never leak.
rm -rf "$run_dir"
rm -f "$pidfile" "$file"
exit "$rc"
